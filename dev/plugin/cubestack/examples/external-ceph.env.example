# Template for the external-ceph.env import file that preflight takes via
# --external-ceph-env at Step 0.
#
# PLACEHOLDERS ONLY. Never commit a real key: this file is a template, and a
# real export carries live CephX credentials. Take the real file from the
# Provider and save it VERBATIM (their import guide section 3 says to save that
# content unchanged, one line unaltered).
#
# Keep a real file free of backticks, of dollar-paren command substitution and
# of stray ASCII quotes: the installer SOURCES this file, so command
# substitution would execute as a command, and the lint tracks quote state
# across lines, so a lone apostrophe in a comment reads as an unterminated
# string. The lint and configure both refuse such a file.
#
# WHY THE FULL SET MATTERS. preflight lints only the four ROOK_EXTERNAL_* keys
# marked REQUIRED below, but the official import path in 03_ceph_csi.sh also
# consumes the CSI_*_SECRET / CSI_*_SECRET_NAME pairs and CEPHX_KEY_GENERATION,
# WITHOUT defaults — an external Ceph is not managed by this box, so those
# CephX users cannot be created here and must arrive in this file. A file
# holding only the linted four passes Step 0 and then dies mid-deploy with:
#
#     CSI_RBD_PROVISIONER_SECRET_NAME: unbound variable
#
# Values below are placeholders: <...>. Quoting them keeps the template
# sourceable (an unquoted < would parse as a redirection).
#
# Consumed by: cubestack-addon/rook/external/import-external-cluster.sh and
# scripts/modules/03_addon/03_ceph_csi.sh (official import path only).

# The export record; kept for fidelity with the Provider file. Multi-line value,
# double-quoted on purpose.
export ARGS="[Configurations]
namespace = <ceph-namespace>
rgw-pool-prefix = <rgw-pool-prefix>
format = bash
output = /etc/ceph/external-ceph.env
cephfs-filesystem-name = <cephfs-name>
cephfs-metadata-pool-name = <cephfs-metadata-pool>
cephfs-data-pool-name = <cephfs-data-pool>
rbd-data-pool-name = <rbd-pool>
rgw-endpoint = <rgw-ip>:<rgw-port>
rgw-realm-name = <rgw-realm>
rgw-zone-name = <rgw-zone>
rgw-zonegroup-name = <rgw-zonegroup>
"

# Key generation of the CephX users below. 0 means the names carry no suffix;
# otherwise every user is <name>.<n> and the import appends the suffix itself.
export CEPHX_KEY_GENERATION='<generation>'
export NAMESPACE='<ceph-namespace>'

# ---- the four the installer refuses to proceed without (preflight lints these)
export ROOK_EXTERNAL_FSID='<cluster-fsid-uuid>'
# The health and monitoring user. Base name: WITH the client. prefix, WITHOUT
# the generation suffix (the import adds it via CEPHX_KEY_GENERATION).
export ROOK_EXTERNAL_USERNAME='client.<health-checker-user>'
# mon-name=mon-ip:port, comma-separated for several mons. A bare ip:port parses
# to ZERO monitors and the import then fails with
#   spec.monitors: Invalid value: 0: ... should have at least 1 items
export ROOK_EXTERNAL_CEPH_MON_DATA='<mon-name>=<mon-ip>:6789'
# The key of client.<health-checker-user>.<generation>.
export ROOK_EXTERNAL_USER_SECRET='<health-checker-key>'

# ---- the CSI secret-name and key pairs the StorageClasses reference. Names are
# the base form (no generation suffix): the import writes the Secrets as
# rook-<name> and appends the key generation to the userID inside.
export CSI_RBD_PROVISIONER_SECRET_NAME='csi-rbd-provisioner'
export CSI_RBD_PROVISIONER_SECRET='<rbd-provisioner-key>'
export CSI_RBD_NODE_SECRET_NAME='csi-rbd-node'
export CSI_RBD_NODE_SECRET='<rbd-node-key>'
export CSI_CEPHFS_PROVISIONER_SECRET_NAME='csi-cephfs-provisioner'
export CSI_CEPHFS_PROVISIONER_SECRET='<cephfs-provisioner-key>'
export CSI_CEPHFS_NODE_SECRET_NAME='csi-cephfs-node'
export CSI_CEPHFS_NODE_SECRET='<cephfs-node-key>'

# ---- pools and filesystem
export RBD_POOL_NAME='<rbd-pool>'
export CEPHFS_FS_NAME='<cephfs-name>'
export CEPHFS_POOL_NAME='<cephfs-data-pool>'
export CEPHFS_METADATA_POOL_NAME='<cephfs-metadata-pool>'

# ---- object store (RGW / S3). Omit the RGW_* keys on a block-only deployment:
# the model-repository OBC and the rgw-admin-ops-user Secret are then skipped.
export RGW_POOL_PREFIX='<rgw-pool-prefix>'
export RGW_ENDPOINT='<rgw-ip>:<rgw-port>'
export RGW_ADMIN_OPS_USER_ACCESS_KEY='<rgw-admin-ops-access-key>'
export RGW_ADMIN_OPS_USER_SECRET_KEY='<rgw-admin-ops-secret-key>'

# ---- informational, not read by the installer
export ROOK_EXTERNAL_DASHBOARD_LINK='https://<mgr-ip>:8443/'
export MONITORING_ENDPOINT='<mgr-ip>'
export MONITORING_ENDPOINT_PORT='9283'
