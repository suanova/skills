# external-ceph.env — the Provider's external-Ceph import file, passed to
# preflight via --external-ceph-env. Placeholders only; the real file comes from
# the Provider and is used verbatim. See cubestack-install.md for why the full
# key set matters (the lint checks only the four ROOK_EXTERNAL_* keys).

export ARGS="[Configurations]
namespace = <ceph-namespace>
rgw-pool-prefix = <rgw-pool-prefix>
format = bash
output = /etc/ceph/external-ceph.env
cephfs-filesystem-name = <cephfs-name>
cephfs-metadata-pool-name = <cephfs-metadata-pool>
cephfs-data-pool-name = <cephfs-data-pool>
rbd-data-pool-name = <rbd-pool>
rgw-endpoint = <rgw-ip>:<rgw-port>
rgw-realm-name = <rgw-realm>
rgw-zone-name = <rgw-zone>
rgw-zonegroup-name = <rgw-zonegroup>
"
export CEPHX_KEY_GENERATION='<generation>'
export NAMESPACE='<ceph-namespace>'
export ROOK_EXTERNAL_FSID='<fsid>'
export ROOK_EXTERNAL_USERNAME='client.<healthchecker-user>'
export ROOK_EXTERNAL_CEPH_MON_DATA='<mon-name>=<mon-ip>:6789'
export ROOK_EXTERNAL_USER_SECRET='<healthchecker-key>'
export ROOK_EXTERNAL_DASHBOARD_LINK='https://<mgr-ip>:8443/'
export CSI_RBD_NODE_SECRET='<rbd-node-key>'
export CSI_RBD_NODE_SECRET_NAME='csi-rbd-node'
export CSI_RBD_PROVISIONER_SECRET='<rbd-provisioner-key>'
export CSI_RBD_PROVISIONER_SECRET_NAME='csi-rbd-provisioner'
export CEPHFS_POOL_NAME='<cephfs-data-pool>'
export CEPHFS_METADATA_POOL_NAME='<cephfs-metadata-pool>'
export CEPHFS_FS_NAME='<cephfs-name>'
export CSI_CEPHFS_NODE_SECRET='<cephfs-node-key>'
export CSI_CEPHFS_PROVISIONER_SECRET='<cephfs-provisioner-key>'
export CSI_CEPHFS_NODE_SECRET_NAME='csi-cephfs-node'
export CSI_CEPHFS_PROVISIONER_SECRET_NAME='csi-cephfs-provisioner'
export MONITORING_ENDPOINT='<mgr-ip>'
export MONITORING_ENDPOINT_PORT='9283'
export RBD_POOL_NAME='<rbd-pool>'
export RGW_POOL_PREFIX='<rgw-pool-prefix>'
export RGW_ENDPOINT='<rgw-ip>:<rgw-port>'
export RGW_ADMIN_OPS_USER_ACCESS_KEY='<rgw-access-key>'
export RGW_ADMIN_OPS_USER_SECRET_KEY='<rgw-secret-key>'
